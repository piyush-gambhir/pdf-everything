# Default matches dev Docker (docker run -p 8010:8010)
PORT=8010

# Optional: require Authorization: Bearer <token> on all render routes
# API_TOKEN=

# Optional request body limit (default: 5 MiB)
# MAX_REQUEST_BYTES=5242880

# Optional: renders at once; one more is answered 503 worker_busy (default: 4)
# MAX_ACTIVE_RENDERS=4

# Optional: one JSON timing line per render on stdout; off with 0/false/off/no (default: on)
# RENDER_TIMING_LOG=on

# Optional render limits (defaults: 200 pages, 25 MiB, 50 seconds)
# MAX_PDF_PAGES=200
# MAX_PDF_BYTES=26214400
# RENDER_DEADLINE_MS=50000

# Chromium / Chrome (Dockerfile sets /usr/bin/chromium)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
