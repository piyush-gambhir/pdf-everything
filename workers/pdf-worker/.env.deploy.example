# Copy this file to .env.deploy.lambda and fill in the AWS values.
# The destination is gitignored; never commit real values.
#
# Used by scripts/deploy-lambda.sh. AWS credentials come from the environment
# or the standard AWS CLI credential files.
# AWS_REGION=ap-south-1
# ECR_REPOSITORY=pdf-everything-pdf-worker
# FUNCTION_NAME=pdf-everything-pdf-worker
# LAMBDA_EXECUTION_ROLE_ARN=arn:aws:iam::<account-id>:role/<lambda-exec-role>
#
# Optional overrides:
# ARCHITECTURE=arm64                   # arm64 | x86_64
# MEMORY_MB=2048                       # Chromium needs headroom (>=1536)
# TIMEOUT_S=60
# FUNCTION_URL_AUTH=AWS_IAM            # AWS_IAM | NONE  (NONE = publicly invokable)
# API_TOKEN=                           # if set, required on all render routes
