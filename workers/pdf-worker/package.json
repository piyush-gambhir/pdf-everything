{
  "name": "pdf-worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Standalone HTML and Markdown → PDF service powered by headless Chromium.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/deploy/docker/index.js",
    "dev": "tsx watch deploy/docker/index.ts",
    "render": "tsx scripts/render.ts",
    "test": "vitest run",
    "test:integration": "RUN_BROWSER_INTEGRATION=1 vitest run tests/typescript/integration.test.ts",
    "test:watch": "vitest",
    "format": "prettier --write \"core/**/*.ts\" \"deploy/docker/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"core/**/*.ts\" \"deploy/docker/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "marked": "^18.1.1",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
