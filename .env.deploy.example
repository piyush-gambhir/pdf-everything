# PDF Everything - Deployment Configuration Example
# Copy to .env.deploy and fill in.
# Both files are gitignored — never commit real secrets.

# Registry / Docker credentials
DOCKER_REGISTRY=ghcr.io
REGISTRY_USERNAME=piyush-gambhir
REGISTRY_TOKEN=

# Service Ports & Storage
API_PORT=3001
WEB_PORT=3000
STORAGE_DIR=./storage
FILE_TTL_HOURS=24
MAX_UPLOAD_MB=100

# Private Worker URLs & Tokens
PDF_CORE_WORKER_URL=http://127.0.0.1:8020
PDF_CORE_WORKER_TOKEN=
PDF_RENDER_WORKER_URL=http://127.0.0.1:8010
PDF_RENDER_WORKER_TOKEN=

# --- Turborepo Remote Caching ---
TURBO_TOKEN=
TURBO_TEAM=piyushgambhir
