{
  "name": "@pdf-everything/web",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fumadocs-mdx && next dev -p 3002",
    "build": "fumadocs-mdx && next build",
    "build:cloudflare": "fumadocs-mdx && next build && node ../scripts/prepare-cloudflare-assets.mjs pdf-everything",
    "deploy": "pnpm build:cloudflare && wrangler deploy",
    "start": "next start -p 3002",
    "lint": "eslint",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "clean": "rm -rf .next out .cloudflare .source"
  },
  "dependencies": {
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "wrangler": "^4.153.0"
  }
}
