{
  "name": "@pdf-everything/console",
  "version": "0.1.3",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "rm -rf .next",
    "deploy": "pnpm build:cloudflare && wrangler deploy",
    "preview": "wrangler dev",
    "build:cloudflare": "next build && node ../scripts/prepare-cloudflare-assets.mjs pdf-everything/console",
    "bundle:analyze": "next analyze --output",
    "bundle:export": "next analyze export"
  },
  "dependencies": {
    "@pdf-everything/types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": "26.x"
  }
}
