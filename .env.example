API_PORT=3001
WEB_PORT=3000
STORAGE_DIR=./storage
FILE_TTL_HOURS=24
MAX_UPLOAD_MB=100

# Nest -> private PDF core worker
PDF_CORE_WORKER_URL=http://127.0.0.1:8020
# PDF_CORE_WORKER_TOKEN=replace-with-a-long-random-secret

# Same value as PDF_CORE_WORKER_TOKEN when worker auth is enabled
# WORKER_API_TOKEN=replace-with-a-long-random-secret

# Nest -> private Chromium render worker
PDF_RENDER_WORKER_URL=http://127.0.0.1:8010
# PDF_RENDER_WORKER_TOKEN=replace-with-a-long-random-secret
